# Copy to `.env` and fill in real values. Never commit `.env` — it is gitignored.

# --- Database ---
# MongoDB Atlas SRV connection string.
# Atlas > Database > Connect > Drivers. Allow 0.0.0.0/0 under Network Access when hosting on a
# platform without a static egress IP (e.g. Render).
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.example.mongodb.net/resumecraft?retryWrites=true&w=majority

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# --- AI provider (Google Gemini via its OpenAI-compatible endpoint) ---
# Key from Google AI Studio. Named OPENAI_API_KEY because the official openai SDK reads that name.
OPENAI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-2.5-flash when unset. Note: gemini-1.5-flash is retired and 404s.
OPENAI_MODEL=gemini-2.5-flash

# --- Image storage (ImageKit) ---
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# --- Server ---
PORT=5000
# Comma-separated list of browser origins allowed to call this API.
# Leave unset to allow all origins (convenient for local development only).
CORS_ORIGIN=http://localhost:5173
